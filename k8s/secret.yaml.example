# k8s/secret.yaml.example
# Copiar como k8s/secret.yaml (ignorado por .gitignore) o crear el Secret por CLI:
#   kubectl create secret generic tusalud-secret \
#     --from-literal=MYSQL_ROOT_PASSWORD=TU_PASSWORD \
#     --from-literal=DB_USER=root \
#     --from-literal=DB_PASSWORD=TU_PASSWORD
apiVersion: v1
kind: Secret
metadata:
  name: tusalud-secret
  labels:
    app: tusalud
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "REEMPLAZAR_CON_PASSWORD_MYSQL"
  DB_USER: "root"
  DB_PASSWORD: "REEMPLAZAR_CON_PASSWORD_MYSQL"

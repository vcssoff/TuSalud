# ==============================================================================
# .env.example — Plantilla de Variables de Entorno para TuSalud
# Copiar este archivo como ".env" y completar con las credenciales reales.
# NUNCA hacer commit del archivo ".env".
# ==============================================================================

# Configuración del Servidor Web (Javalin)
PORT=8080

# Configuración de Base de Datos MySQL (Aiven Cloud / Docker Local)
# - Aiven Cloud: completar con host, puerto, base, usuario y contraseña reales.
# - Docker Compose local: puedes dejarlos vacíos o usar DB_HOST=mysql-db y DB_SSL_MODE=DISABLED.
# Valores válidos para DB_SSL_MODE: REQUIRED (por defecto), VERIFY_CA, DISABLED
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=

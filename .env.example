# ==============================================================================
# .env.example — Plantilla de Variables de Entorno para TuSalud
# Copiar este archivo como ".env" y completar con las credenciales de Railway
# ==============================================================================

# Configuración del Servidor Web (Javalin)
PORT=8080

# Configuración de Base de Datos MySQL (Railway / Docker Local)
DB_HOST=sakura.proxy.rlwy.net
DB_PORT=19832
DB_NAME=railway
DB_USER=root
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_DE_RAILWAY
DB_SSL=true
